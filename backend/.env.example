# ── LLM ──────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# ── Data source: csv | sql | excel | pdf ─────────────
DATA_SOURCE=csv

# ── Supabase (database) ───────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── SQL (only if DATA_SOURCE=sql) ────────────────────
DATABASE_URL=postgresql://user:password@host:5432/flota

# ── Excel (only if DATA_SOURCE=excel) ────────────────
EXCEL_PATH=data/

# ── PDF (only if DATA_SOURCE=pdf) ────────────────────
PDF_PATH=data/report.pdf

# ── API ───────────────────────────────────────────────
API_PORT=8000
